# =============================================================================
# DEPLOYER WALLET
# =============================================================================
# Never commit this file with real values. Use a fresh, dedicated key per
# environment (one for testnets, a separate hardware/multisig-backed one for
# mainnet). Never reuse a key that has ever been shared, pasted, or committed.
PRIVATE_KEY=

# =============================================================================
# TOKEN PARAMETERS (read by script/DeployMyToken.s.sol)
# =============================================================================
TOKEN_NAME=MyToken
TOKEN_SYMBOL=MTK
INITIAL_SUPPLY=1000000000000000000000000
MAX_SUPPLY=10000000000000000000000000
TOKEN_OWNER=

# =============================================================================
# TESTNET RPC URLS
# =============================================================================
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
HOLESKY_RPC_URL=https://holesky.infura.io/v3/YOUR_KEY

ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
OPTIMISM_SEPOLIA_RPC_URL=https://sepolia.optimism.io
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FANTOM_TESTNET_RPC_URL=https://rpc.testnet.fantom.network/
CELO_ALFAJORES_RPC_URL=https://alfajores-forno.celo-testnet.org
GNOSIS_CHIADO_RPC_URL=https://rpc.chiadochain.net
LINEA_SEPOLIA_RPC_URL=https://rpc.sepolia.linea.build
SCROLL_SEPOLIA_RPC_URL=https://sepolia-rpc.scroll.io
ZKSYNC_SEPOLIA_RPC_URL=https://sepolia.era.zksync.dev
MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz
BLAST_SEPOLIA_RPC_URL=https://sepolia.blast.io

# =============================================================================
# MAINNET RPC URLS
# =============================================================================
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org

POLYGON_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org/
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
FANTOM_RPC_URL=https://rpc.ftm.tools/
CELO_RPC_URL=https://forno.celo.org
GNOSIS_RPC_URL=https://rpc.gnosischain.com
LINEA_RPC_URL=https://rpc.linea.build
SCROLL_RPC_URL=https://rpc.scroll.io
ZKSYNC_RPC_URL=https://mainnet.era.zksync.io
MANTLE_RPC_URL=https://rpc.mantle.xyz
BLAST_RPC_URL=https://rpc.blast.io

# =============================================================================
# BLOCK EXPLORER API KEYS (for `--verify`)
# One key per explorer family. Most are free — sign up on the explorer's site.
# =============================================================================
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISTIC_ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
POLYGONSCAN_API_KEY=
BSCSCAN_API_KEY=
SNOWTRACE_API_KEY=
FTMSCAN_API_KEY=
CELOSCAN_API_KEY=
GNOSISSCAN_API_KEY=
LINEASCAN_API_KEY=
